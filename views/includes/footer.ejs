<footer class="main-footer mt-5">
  <div class="f-info container">
    <!-- Social icons -->
    <div class="f-info-socials">
      <a
        href="https://www.linkedin.com/in/pandeysomesh/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
      >
        <i class="fa-brands fa-linkedin"></i>
      </a>
      <a
        href="https://x.com/Hey_Somesh"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X (Twitter)"
      >
        <i class="fa-brands fa-x-twitter"></i>
      </a>
    </div>

    <!-- Brand text -->
    <div class="f-info-brand">
      &copy; <%= new Date().getFullYear() %> Wanderlust Private Limited
