<% layout("/layouts/boilerplate") %>

<style>
  .favorites-container {
    padding: 2rem 0;
  }

  .favorites-empty {
    text-align: center;
    padding: 4rem 1rem;
  }

  .favorites-empty i {
    font-size: 3rem;
    color: #ccc;
    margin-bottom: 1rem;
  }

  .favorites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }
</style>

<div class="favorites-container">
  <div class="col-12 mb-4">
    <h2><i class="fa-solid fa-heart" style="color: #fe424d;"></i> My Favorites</h2>
    <p class="text-muted">
      <% if(favoriteListings.length > 0) { %>
        <%= favoriteListings.length %> listing<%= favoriteListings.length !== 1 ? 's' : '' %> saved
      <% } %>
    </p>
  </div>

  <% if(favoriteListings && favoriteListings.length > 0) { %>
    <div class="favorites-grid">
      <% for(let listing of favoriteListings) { %>
        <a href="/listings/<%=listing._id%>" class="listing-link">
          <div class="card listing-card" style="height: 100%;">
            <div class="position-relative">
              <img
                src="<%= listing.image.url %>"
                class="card-img-top"
                alt="<%= listing.title %>"
                style="height: 200px; object-fit: cover;"
              />
              <div class="position-absolute top-0 end-0 p-2">
                <div class="heart-icon" data-id="<%= listing._id %>" style="position: static;">
                  <i class="fa-solid fa-heart favorite-heart"></i>
                </div>
              </div>
            </div>
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= listing.title %></h5>
              <p class="card-text text-muted">
                <%= listing.location %>, <%= listing.country %>
              </p>
              <p class="card-text mt-auto">
                <strong>
                  &#8377; <%= listing.price.toLocaleString("en-IN") %>
                </strong>
              </p>
            </div>
          </div>
        </a>
      <% } %>
    </div>
  <% } else { %>
    <div class="favorites-empty">
      <i class="fa-regular fa-heart"></i>
      <h5>No favorites yet</h5>
      <p class="text-muted">Start adding listings to your favorites!</p>
      <a href="/listings" class="btn btn-dark">Browse Listings</a>
    </div>
  <% } %>
</div>

<script>
  const heartIcons = document.querySelectorAll(".heart-icon");

  heartIcons.forEach((icon) => {
    icon.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();

      const listingId = icon.dataset.id;

      try {
        const response = await fetch(`/listings/${listingId}/favorite`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          }
        });

        const data = await response.json();

        if (data.success && !data.isFavorited) {
          // Remove from page if unfavorited
          const card = icon.closest(".card");
          if (card) {
            card.closest("a").remove();
          }
          // Reload if empty
          if (document.querySelectorAll(".card").length === 0) {
            location.reload();
          }
        }
      } catch (error) {
        console.error("Error:", error);
      }
    });
  });
</script>
